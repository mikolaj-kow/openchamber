+export const parseCiUrl = (value: string, identity?: { provider: string; instance: string } | null): CiTarget | null => {
+  const text = value.trim();
+  if (!text || !URL.canParse(text)) return null;
+  const url = new URL(text);
+  if (url.protocol !== 'https:' && url.protocol !== 'http:') return null;
+  const host = url.hostname.toLowerCase().replace(/^www\./, '');
+  const commit = CI_COMMIT.exec(url.pathname);
+  const branch = CI_BRANCH.exec(url.pathname);
+  if (!commit && !branch) return null;
+  const owner = (commit?.[1] ?? branch?.[1]) ?? '';
+  const repo = (commit?.[2] ?? branch?.[2]) ?? '';
+  if (!owner || !repo) return null;
+  const provider = identity?.provider ?? (url.pathname.includes('/-/') ? 'gitlab' : 'github');
+  const instance = identity?.instance ?? (provider === 'github' ? host : url.origin);
+  if (!instance) return null;
+  const target: CiTarget = { provider, instance, owner, repo };
+  if (commit?.[3]) target.sha = commit[3];
+  if (branch?.[3]) {
+    try { target.branch = decodeURIComponent(branch[3]); } catch { target.branch = branch[3]; }
+  }
+  return target;
+};
